GUI r
DELAY 1000
STRING https://youtube.com/shorts/q-OO3fjbh5A?si=Sp8JUD56Ws-mzaR-
DELAY 1000
ENTER

REM Now blast the video over WiFI
ESP32M attack WiFI

VAR $INDEX = 1
WHILE (TRUE)
    IF ($INDEX == 1)
        DISPLAY_PNG /1.png
    ELSE IF ($INDEX == 2)
        DISPLAY_PNG /2.png
    ELSE IF ($INDEX == 3)
        DISPLAY_PNG /3.png
    END_IF

    $INDEX = ( $INDEX + 1 )
    IF ($INDEX == 4)
        $INDEX = 1
    END_IF
    
    DELAY 500
END_WHILE
